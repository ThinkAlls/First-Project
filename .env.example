# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection variables (injected at runtime in AI Studio,
# or configured for local Cloud SQL Auth Proxy development)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Optional: Initial Ketua DKM password override for automated seeding
ADMIN_INITIAL_PASSWORD=

# Optional: Payment Gateway API & Webhook Secrets (server-side only, never prefix with VITE_)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

